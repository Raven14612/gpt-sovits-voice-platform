@startuml
left to right direction
skinparam defaultFontName Microsoft YaHei
actor "开发者" as Dev
actor "项目使用者" as User
rectangle "统一状态与错误处理" {
 usecase "状态转换" as A
 usecase "统一错误" as B
 usecase "日志与恢复" as C
}
Dev --> A
Dev --> B
Dev --> C
User --> B
A ..> C : <<include>>
B ..> C : <<include>>
@enduml
