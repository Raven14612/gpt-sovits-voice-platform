@startuml
left to right direction
skinparam defaultFontName Microsoft YaHei
actor "项目使用者" as User
actor "观察者" as Viewer
rectangle "历史记录与结果管理" {
 usecase "历史查询" as A
 usecase "结果复用" as B
 usecase "结果删除" as C
}
User --> A
User --> B
User --> C
Viewer --> A
B ..> A : <<include>>
C ..> A : <<include>>
@enduml
