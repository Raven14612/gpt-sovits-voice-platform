@startuml
skinparam defaultFontName Microsoft YaHei
|项目使用者|
start
:选择数据集和音色 ID;
|系统|
:创建 pending 训练任务;
if (GPU 空闲?) then (是)
  :转为 running;
  :执行训练阶段;
  if (训练和权重输出成功?) then (是)
    :保存 GPT/SoVITS 权重;
    :写入 VoiceProfile;
    :任务 SUCCEEDED;
  else (否)
    :任务 FAILED;
  endif
  :释放 GPU 锁;
else (否)
  :返回 GPU_BUSY;
endif
stop
@enduml
